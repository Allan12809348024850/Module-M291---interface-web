{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Catalogue Lêkê Sneakers",
  "description": "Valide data.json : un tableau de paires de sneakers.",
  "type": "array",
  "minItems": 30,
  "items": {
    "type": "object",
    "required": ["id", "marque", "modele", "prix", "enStock", "pointures"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "integer", "minimum": 1 },
      "marque": { "type": "string", "minLength": 1 },
      "modele": { "type": "string", "minLength": 1 },
      "categorie": {
        "type": "string",
        "enum": ["running", "lifestyle", "basket", "skate", "trail"]
      },
      "couleur": { "type": "string" },
      "description": { "type": "string", "maxLength": 160 },
      "prix": { "type": "number", "minimum": 0, "maximum": 160 },
      "enStock": { "type": "boolean" },
      "pointures": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "integer", "minimum": 35, "maximum": 47 }
      },
      "tags": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string" }
      },
      "magasin": { "type": "string" },
      "image": { "type": "string", "pattern": "^images/.+\\.(webp|jpg|png)$" }
    }
  }
}
